{
    "name": "@addons/core",
    "version": "1.0.0",
    "description": "Stremio-addon aggregation backend exposing an OMSS-compliant API. Turns any Stremio addon into a movie/TV source provider, importable from a URL, a Stremio account, or an addon repository.",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "npm run build && node dist/server.js",
        "serve": "node dist/server.js",
        "test": "npm run build && node --test test/*.test.js",
        "test:clean": "npm run clean && npm run test",
        "test:coverage": "node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test-reporter=dot --test-reporter-destination=stdout test/*.test.js",
        "check:coverage": "npm run build && node scripts/check-coverage.js",
        "check:deadcode": "knip --include files,dependencies,unlisted,binaries,cycles",
        "scan:secrets": "sh scripts/secret-scan.sh --all",
        "perf": "npm run build && node scripts/perf/load.js",
        "format": "prettier --write src",
        "format:check": "prettier --check src",
        "lint": "eslint src",
        "clean": "npx rimraf dist",
        "prepare": "git config core.hooksPath .githooks || true",
        "sbom": "node scripts/sbom.js"
    },
    "dependencies": {
        "@omss/framework": "^1.1.26",
        "dotenv": "^16.4.5",
        "js-yaml": "^5.3.0",
        "nanoid": "^5.1.5",
        "pg": "^8.23.0",
        "redis": "^6.2.1",
        "undici": "^6.27.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.9.1",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^22.7.4",
        "@types/pg": "^8.21.0",
        "eslint": "^9.9.1",
        "eslint-config-prettier": "^9.1.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-security": "^4.0.1",
        "knip": "^6.33.0",
        "prettier": "^3.3.3",
        "tsx": "^4.19.1",
        "typescript": "^5.6.2",
        "typescript-eslint": "^8.4.0"
    },
    "engines": {
        "node": ">=20"
    }
}

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3006            # Port to listen on (cineflix-core uses 3005; pick a distinct one)
HOST=localhost       # Use '0.0.0.0' to accept LAN/internet connections (EC2)
NODE_ENV=development # 'development' | 'production'
# PUBLIC_URL="https://addons.yourdomain.tld"  # Public base URL (reverse proxy / EC2). NO TRAILING SLASH.
                                              # Used to build absolute /v1/proxy URLs the browser hits.
CORS_ORIGIN="*"      # CORS origin. '*' or a specific origin like https://cineflix.example
INTERNAL_DEBUG=false # 'true' keeps non-playable/unvalidated sources (debug only)

# ─── TMDB (required by @omss/framework) ────────────────────────────────────────
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_CACHE_TTL=86400

# ─── Cache ─────────────────────────────────────────────────────────────────────
CACHE_TYPE=memory    # 'memory' | 'redis'
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Addon persistence ──────────────────────────────────────────────────────────
ADDONS_STORE=file            # 'file' | 'redis'
ADDONS_DATA_FILE=./data/addons.json
# ADDONS_SEED_URLS=https://a/manifest.json,https://b/manifest.json  # optional first-boot seed

# ─── Admin UI + management API ──────────────────────────────────────────────────
ADMIN_ENABLED=true           # Serve the web admin UI at /admin
# ADMIN_TOKEN=change-me       # If set, all /v1/addons* management calls require
                              #   header 'x-admin-token: <token>' (and the admin UI prompts for it)

# ─── Scrape egress proxy (avoid EC2/datacenter IP blocks) ───────────────────────
# Route addon + stream fetches through a residential/other HTTP proxy so upstreams
# don't 403/429 a datacenter IP. Leave empty to disable.
# PROXY_URL=http://user:pass@host:port
# SCRAPE_PROXY_URL=            # alias for PROXY_URL
SCRAPE_PROXY_MODE=all          # 'all' | 'allowlist' | 'off'  (addon hosts are arbitrary → 'all')
SCRAPE_PROXY_STREAM=true       # Also route /v1/proxy stream fetches through the proxy
# SCRAPE_PROXY_HOSTS=          # extra comma-separated host suffixes for 'allowlist' mode
# SCRAPE_PROXY_DIRECT_HOSTS=api.themoviedb.org,api.strem.io  # never proxied (control plane)

# ─── Debrid (unlock torrent addons like Torrentio/MediaFusion/Comet) ────────────
# Resolves torrent (infoHash) streams into playable HTTP links via your debrid
# account. Only already-cached torrents are used. Env config takes precedence
# over anything set in the admin UI (and locks the UI fields).
DEBRID_PROVIDER=none         # 'none' | 'realdebrid' | 'alldebrid' | 'premiumize'
# DEBRID_API_KEY=your_debrid_api_key

# ─── Health monitoring + auto-refresh ───────────────────────────────────────────
ADDON_HEALTH_INTERVAL_MINUTES=15  # Background manifest health checks (0 = off)
ADDON_AUTO_REFRESH=false          # Also re-fetch manifests on each health sweep

# ─── Stremio native re-exposure (optional) ──────────────────────────────────────
STREMIO_ADDON=false          # 'true' exposes this backend itself at /stremio/manifest.json
